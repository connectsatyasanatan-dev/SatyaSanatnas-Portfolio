# Flask Configuration
SECRET_KEY=dev-secret-key-change-in-production
FLASK_ENV=development
PORT=5000

# JWT
JWT_SECRET_KEY=dev-jwt-secret-change-in-production
JWT_EXPIRY_HOURS=24

# Email Configuration (for contact form)
# Use an App Password, not your real Gmail password!
# Guide: https://support.google.com/accounts/answer/185833
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# CORS Origins (comma-separated list of allowed frontend URLs)
# Local dev:  http://localhost:3000,http://localhost:5173
# Production: https://your-portfolio.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin Credentials (change these in production!)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@portfolio.dev
