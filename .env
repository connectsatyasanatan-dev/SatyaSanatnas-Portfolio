#############################
# PostgreSQL
#############################

POSTGRES_USER=myuser
POSTGRES_PASSWORD=StrongPassword123
POSTGRES_DB=portfolio_db

#############################
# Flask
#############################

FLASK_ENV=production

SECRET_KEY=SomeFlaskSecretKey123!

DATABASE_URL=postgresql://myuser:StrongPassword123@db:5432/portfolio_db

JWT_SECRET_KEY=CHANGE_THIS_SECRET_KEY

#############################
# Cloudinary
#############################

CLOUDINARY_URL=cloudinary://YOUR_KEY

#############################
# Mail
#############################

MAIL_USERNAME=example@gmail.com
MAIL_PASSWORD=your-app-password

#############################
# Next.js
#############################

# 1. Used by Next.js server to connect to backend within Docker network
BACKEND_URL=http://backend:5000

# 2. Used by Browser (Client) to connect to backend over Internet
# IMPORTANT: Replace "localhost" with your Oracle Public IP for production!
NEXT_PUBLIC_API_URL=http://localhost:5000